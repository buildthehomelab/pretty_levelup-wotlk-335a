<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
	<Script file="config.lua"/>
	<Script file="utils.lua"/>
	<Script file="locale.lua"/>
	<Script file="core.lua"/>

	<Button name="LearnedAlertButtonTemplate" parent="UIParent" toplevel="true" frameLevel="120" frameStrata="FULLSCREEN_DIALOG" hidden="true" virtual="true">
		<Size x="276" y="96"/>
		<Animations>
			<AnimationGroup parentKey="animIn">
				<Alpha change="0" duration="0" order="1"/>
				<Alpha change="1" duration="0.2" order="2"/>
				<Scripts>
					<OnFinished>
						self:GetParent().waitAndAnimOut:Play()
					</OnFinished>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="waitAndAnimOut">
				<Alpha startDelay="4.05" change="-1" duration="1.5" parentKey="animOut">
					<Scripts>
						<OnFinished>
							self:GetParent():GetParent():Hide()
						</OnFinished>
					</Scripts>
				</Alpha>
			</AnimationGroup>
		</Animations>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" file="Interface\AddOns\LearnedAlert\assets\loottoast">
					<Size x="276" y="96"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<TexCoords left="0.28222656" right="0.55175781" top="0.57812500" bottom="0.95312500"/>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentIcon" parentKey="Icon" file="Interface\AddOns\LearnedAlert\assets\unknow_treasure">
					<Size x="52" y="52"/>
					<Anchors>
						<Anchor point="LEFT" x="23" y="-2"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="IconBorder" file="Interface\AddOns\LearnedAlert\assets\LootToastAtlas">
					<Size x="58" y="58"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentIcon" relativePoint="CENTER" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0.34082" right="0.397461" top="0.882812" bottom="0.996094"/>
				</Texture>
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
					<Size x="167" y="16"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT" x="7" y="5"/>
					</Anchors>
				</FontString>
				<FontString parentKey="ItemName" inherits="GameFontNormalMed3" justifyH="LEFT" justifyV="MIDDLE">
					<Size x="167" y="33"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT" x="10" y="-16"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY">
				<Texture file="Interface\AddOns\LearnedAlert\assets\LootToastAtlas" alphaMode="ADD" hidden="true" parentKey="glow">
					<Size x="286" y="109"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0.000976562" right="0.280273" top="0.00195312" bottom="0.214844"/>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="-1" duration="0" order="1"/>
							<Alpha change="1" duration="0.2" order="2"/>
							<Alpha change="-1" duration="0.5" order="3"/>
							<Scripts>
								<OnPlay>
									self:GetParent():Show()
								</OnPlay>
								<OnFinished>
									self:GetParent():Hide()
								</OnFinished>
							</Scripts>
						</AnimationGroup>
					</Animations>
				</Texture>
				<Texture file="Interface\AddOns\LearnedAlert\assets\LootToastAtlas" alphaMode="ADD" hidden="true" parentKey="shine">
					<Size x="171" y="75"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="-10" y="12"/>
					</Anchors>
					<TexCoords left="0.817383" right="0.984375" top="0.21875" bottom="0.365234"/>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="-1" duration="0" order="1"/>
							<Alpha change="1" duration="0.1" order="2"/>
							<Translation offsetX="200" offsetY="0" duration="0.71" order="3"/>
							<Alpha change="-1" duration="0.25" startDelay="0.175" order="3"/>
							<Scripts>
								<OnPlay>
									self:GetParent():Show()
								</OnPlay>
								<OnFinished>
									self:GetParent():Hide()
								</OnFinished>
							</Scripts>
						</AnimationGroup>
					</Animations>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad function="LearnedAlertButtonTemplate_OnLoad"/>
			<OnShow function="LearnedAlertButtonTemplate_OnShow"/>
			<OnHide function="LearnedAlertButtonTemplate_OnHide"/>
			<OnClick function="LearnedAlertButtonTemplate_OnClick"/>
			<OnEnter function="LearnedAlertButtonTemplate_OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
		</Scripts>
	</Button>

	<Frame name="LearnedAlertFrame" parent="UIParent" hidden="false">
		<Size x="10" y="10"/>
		<Anchors>
			<Anchor point="BOTTOM" x="0" y="128"/>
		</Anchors>
		<Scripts>
			<OnLoad function="LearnedAlertFrame_OnLoad"/>
			<OnEvent function="LearnedAlertFrame_OnEvent"/>
			<OnUpdate function="LearnedAlertFrame_OnUpdate"/>
		</Scripts>
	</Frame>

	<Button name="LearnedAlertButton1" inherits="LearnedAlertButtonTemplate" id="1"/>
	<Button name="LearnedAlertButton2" inherits="LearnedAlertButtonTemplate" id="2"/>
	<Button name="LearnedAlertButton3" inherits="LearnedAlertButtonTemplate" id="3"/>
	<Button name="LearnedAlertButton4" inherits="LearnedAlertButtonTemplate" id="4"/>
	<Button name="LearnedAlertButton5" inherits="LearnedAlertButtonTemplate" id="5"/>
	<Button name="LearnedAlertButton6" inherits="LearnedAlertButtonTemplate" id="6"/>
	<Button name="LearnedAlertButton7" inherits="LearnedAlertButtonTemplate" id="7"/>
	<Button name="LearnedAlertButton8" inherits="LearnedAlertButtonTemplate" id="8"/>
</Ui>
